<Layouts.app title={@page_title} open_graph={@open_graph}>
  <main id="notification-unsubscribe">
    <.card title={dgettext("dashboard_account", "Unsubscribe from email updates")} icon="mail">
      <.card_section>
        <div data-part="content">
          <h1>
            {if @scoped?,
              do: dgettext("dashboard_account", "Stop updates about this one?"),
              else: dgettext("dashboard_account", "Stop %{topic}?", topic: @topic_label)}
          </h1>
          <p>
            {if @scoped?,
              do:
                dgettext(
                  "dashboard_account",
                  "Hive will stop sending email about the item this message was about. Everything else you follow stays unchanged."
                ),
              else:
                dgettext(
                  "dashboard_account",
                  "Hive will stop sending this category of email. Other notification preferences stay unchanged."
                )}
          </p>
          <form method="post" action={~p"/notifications/unsubscribe?token=#{@token}"}>
            <.button
              label={dgettext("dashboard_account", "Unsubscribe")}
              type="submit"
              variant="destructive"
              size="medium"
            />
          </form>
          <form
            :if={@scoped?}
            data-part="topic-unsubscribe"
            method="post"
            action={~p"/notifications/unsubscribe?token=#{@topic_token}"}
          >
            <p>
              {dgettext(
                "dashboard_account",
                "Rather stop every email of this kind, including the other items you follow?"
              )}
            </p>
            <.button
              label={dgettext("dashboard_account", "Stop %{topic}", topic: @topic_label)}
              type="submit"
              variant="secondary"
              size="medium"
            />
          </form>
        </div>
      </.card_section>
    </.card>
  </main>
</Layouts.app>
